# Copy to .env.local and fill in. Never commit real values.
#
# Without DATABASE_URL / NEON_AUTH_BASE_URL, `npm run dev` starts a development-only
# demo mode (in-memory data, demo logins, simulated GHL). Production never falls
# back to it: missing configuration fails with a clear error.

# Public origin of the app, no trailing slash (password-reset links). Required in production,
# e.g. https://victory-booking-system.vercel.app
SITE_URL=http://localhost:3000

# Public support address shown on /privacy and /terms (use the same one as the Google OAuth
# consent screen). Optional; without it the pages point people to the church office.
SUPPORT_EMAIL=

# Optional: Google Search Console HTML-tag verification code (the content="…" value), used to
# verify the production domain for Google OAuth branding.
GOOGLE_SITE_VERIFICATION=

# Account to promote with `npm run db:bootstrap-admin` after it signs up.
ADMIN_EMAIL=

# --- Neon -----------------------------------------------------------------
# Postgres connection string (pooled is fine).
DATABASE_URL=
# Neon Console → Auth → Configuration.
NEON_AUTH_BASE_URL=
# 32+ random characters for signing session cookies: `openssl rand -base64 32`.
# Required in production (development falls back to a local-only secret).
NEON_AUTH_COOKIE_SECRET=

# --- Neon Object Storage (private bucket) ---------------------------------
# Neon Console → branch → Object storage → storage credentials. `npm run storage:setup`
# creates the private bucket if it doesn't exist yet.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=booking-assets

# --- HighLevel (GHL) ------------------------------------------------------
# Sub-account Private Integration. Scopes: calendars.readonly, calendars/events.write,
# contacts.readonly, contacts.write, locations.readonly, locations/customFields.readonly
# (optional: users.readonly, so check:integrations can verify each calendar's team member).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=

# One calendar per room (30-minute slot interval, at least one team member assigned —
# appointments are assigned to that staff user). Synced to the rooms table by `npm run db:migrate`.
GHL_CALENDAR_ROOM_A=
GHL_CALENDAR_ROOM_B=
GHL_CALENDAR_ROOM_C=
GHL_CALENDAR_ROOM_D=
GHL_CALENDAR_EVENTS_PLACE_A=

# Contact custom field IDs (not merge tags). If left blank they are looked up by
# field key (contact.booking_room, …) on first use.
GHL_FIELD_BOOKING_ROOM_ID=
GHL_FIELD_BOOKING_EVENT_ID=
GHL_FIELD_BOOKING_DATE_ID=
GHL_FIELD_BOOKING_TIME_ID=
GHL_FIELD_BOOKING_DENIAL_REASON_ID=

# Tag that starts the "Room Booking - Denied" workflow.
GHL_DENIAL_TAG=room-booking-denied

# Account access emails. Workflows trigger on the tags booking-system-user-approved,
# booking-system-user-denied, booking-system-user-revoked and booking-system-user-restored.
# The reason (deny/revoke) is written to this contact field first (key contact.account_access_reason).
GHL_FIELD_ACCOUNT_ACCESS_REASON_ID=
# Optional: text field that mirrors the account status (key contact.account_status).
GHL_FIELD_ACCOUNT_STATUS_ID=

# --- Google Calendar (approved bookings go to each member's calendar) -------
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Required in production; development without these skips the Google step.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client: <SITE_URL>/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32+ random characters; encrypts stored refresh tokens: `openssl rand -base64 32`.
# Changing it disconnects everyone (they reconnect once).
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Verse of the Day ------------------------------------------------------
# Official ESV API key (api.esv.org). Without it the dashboard links to ESV.org instead.
ESV_API_KEY=

# --- WhatsApp booking assistant (n8n) ------------------------------------------
# n8n calls /api/bot/* with `Authorization: Bearer <key>`. 32+ random characters:
# `openssl rand -base64 48`. Without it every bot request is refused (401).
N8N_BOOKING_API_KEY=
# Optional: n8n Webhook URL that receives booking.approved/denied/cancelled for
# WhatsApp bookings, signed with N8N_WEBHOOK_SIGNING_SECRET (HMAC-SHA256, 32+ chars).
N8N_STATUS_WEBHOOK_URL=
N8N_WEBHOOK_SIGNING_SECRET=
